# Server Configuration
PORT=5001
NODE_ENV=development

# Supabase Credentials
# Find these in your Supabase Dashboard under Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# PayPal Credentials (Required for real payment processing)
# Find these in your PayPal Developer Dashboard -> My Apps & Credentials
PAYPAL_CLIENT_ID=your-paypal-client-id-here
PAYPAL_CLIENT_SECRET=your-paypal-client-secret-here

# Admin Panel Secret Key
# This key is required to access the Admin Panel and all write API routes.
# Change this to a long random string before going live!
ADMIN_SECRET_KEY=your-secret-admin-key-here

# Production Storefront URL (Set this when deploying to production)
STOREFRONT_ORIGIN=https://your-production-domain.com
